APP_NAME=Studylikepro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_CHANNEL=daily with LOG_LEVEL=warning, rotated by the log stack

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Studylikepro bootstrap admin (used by database seeders; local seeding falls back to admin@studylikepro.test / password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Marketplace commission withheld from each lesson payout (defaults to 15)
PLATFORM_COMMISSION_PERCENT=15

# Student booking fee added to each lesson at checkout, in minor units (defaults to 10000 = Rs 100)
PLATFORM_BOOKING_FEE_MINOR=10000

# Marketplace currency (Phase 6) — Sri Lankan rupees, rendered as "RS: 1,250.00"
PLATFORM_CURRENCY=LKR
PLATFORM_CURRENCY_SYMBOL="RS:"

# Bookings (Phase 5)
# Students may cancel a confirmed lesson up to this many hours before it starts
BOOKING_CANCEL_WINDOW_HOURS=24
# A lesson the teacher never closed is completed this long after it was due to end
BOOKING_AUTO_COMPLETE_GRACE_MINUTES=20
# Reminders go out this long before a confirmed lesson starts
BOOKING_REMINDER_LEAD_MINUTES=60

# Payments (Phase 6)
# fake = offline gateway for local development and tests, razorpay = live API
PAYMENTS_GATEWAY=fake
FAKE_PAYMENT_WEBHOOK_SECRET=studylikepro-fake-webhook-secret

# Payments - Razorpay (Phase 6)
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Video - Daily.co (Phase 7)
# fake = offline provider for local development and tests, daily = real Daily.co rooms
MEETING_PROVIDER=fake
DAILY_API_KEY=
# DAILY_BASE_URL=https://api.daily.co/v1
# Joins open this many minutes before the lesson starts, and close this many after it ends
MEETING_JOIN_OPENS_MINUTES=15
MEETING_JOIN_CLOSES_MINUTES=30
# How long the provider keeps the room alive after the lesson (covers overruns)
MEETING_ROOM_TTL_MINUTES=240
# Room-creation attempts (including the first) before the booking shows as failed
MEETING_PROVISION_ATTEMPTS=3

# Reviews (Phase 9)
# How long a student can change a review they wrote
REVIEW_EDIT_WINDOW_DAYS=7

# AI topic classification - OpenAI (Phase 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Seeded default for the admin-editable "AI confidence threshold" (0.30-0.95)
AI_MIN_CONFIDENCE=0.55

# Support & compliance (Phase 11)
# Where the contact form sends its notifications, and what the legal pages print
SUPPORT_EMAIL=support@studylikepro.test
SUPPORT_PHONE="+94 70 000 0000"
# Bumped whenever the terms or privacy policy change; recorded on teacher agreement
POLICY_VERSION=2026-10-01

# Security headers (Phase 11)
# Content-Security-Policy is on by default; disable only if a provider is blocked
SECURITY_CSP_ENABLED=true
# HSTS max-age in seconds over HTTPS (0 disables the header)
SECURITY_HSTS_MAX_AGE=31536000

# Rate limits, requests per minute per account (Phase 11)
THROTTLE_LOGIN=20
THROTTLE_REGISTER=10
THROTTLE_REQUESTS=10
THROTTLE_UPLOADS=30
THROTTLE_MESSAGES=60
THROTTLE_CHECKOUT=15
THROTTLE_CONTACT=5
THROTTLE_WEBHOOKS=120

# Teacher onboarding invites
# How many days an admin-issued teacher onboarding link stays valid
TEACHER_INVITE_EXPIRY_DAYS=7
